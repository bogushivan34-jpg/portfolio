# Copy to .env.local (local) or add in your host's settings (Vercel → Project → Settings → Environment Variables).
# Enquiries from the site's form are sent to you in Telegram by this bot.

# 1. In Telegram, open @BotFather → /newbot → copy the token here.
TELEGRAM_BOT_TOKEN=

# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates  and copy "chat":{"id": ...} here.
TELEGRAM_CHAT_ID=
